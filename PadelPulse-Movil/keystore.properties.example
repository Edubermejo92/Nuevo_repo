# Plantilla. Copia este fichero a keystore.properties y pon tus datos reales.
# keystore.properties NO se sube a Git (esta en .gitignore): lleva contraseñas.
# IMPORTANTE: el movil y el reloj comparten applicationId, asi que los dos
# proyectos tienen que usar EXACTAMENTE el mismo keystore, alias y contraseñas.
storeFile=C:/ruta/a/padelpulse.jks
storePassword=TU_PASSWORD
keyAlias=padelpulse
keyPassword=TU_PASSWORD
